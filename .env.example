# ============================================================
# midnight-be — Directus env
#
# 兩種使用情境鍵名不同，請依情境調整：
#
# (a) 本機開發（docker-compose.yml，SQLite）
#     用 KEY / SECRET（compose 已硬編碼這兩個變數）
#
# (b) Production（docker-compose.prod.yml，Postgres）
#     用 DIRECTUS_KEY / DIRECTUS_SECRET 等下方完整變數
#     檔案應位於 VPS 的 /opt/midnight-be/.env，chmod 600
# ============================================================

# ---- 對外 URL（含 protocol，不含尾斜線）----
# 本機：http://localhost:8055
# prod：https://mmoodvie.live
PUBLIC_URL=http://localhost:8055

# ---- Directus 加密金鑰 ----
# 產生方式：openssl rand -hex 32（KEY 與 SECRET 各跑一次，不能重複）
# 變更後既有 token 全部失效
DIRECTUS_KEY=REPLACE_WITH_openssl_rand_hex_32
DIRECTUS_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ---- 初始 admin（首次啟動時建立，之後到 /admin 改密碼）----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_min_16_chars

# ---- Postgres（僅 docker-compose.prod.yml 使用）----
# 產生 DB_PASSWORD：openssl rand -base64 24
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=REPLACE_WITH_openssl_rand_base64_24

# ---- CORS ----
# 本機：http://localhost:5173
# prod：https://mmoodvie.live,https://www.mmoodvie.live
# 切勿在 prod 設為 * 或 true
CORS_ORIGIN=http://localhost:5173

# ---- 本機 scripts/ 用，production 不需要 ----
TMDB_API_KEY=
ANTHROPIC_API_KEY=
MOOD_MAPPER_PORT=3001
